          "model": { "type": "minecraft:model", "model": "villager_life:item/villager_blessing_staff_3d_charged" }
        }
      ],
      "fallback": { "type": "minecraft:model", "model": "villager_life:item/villager_blessing_staff_3d" }
    }
  }
}
